# Copy to .env. The AI service has read-only access to the hub and never writes anywhere.
HUB_API_URL=http://127.0.0.1:8000/api/v1
# Must equal AI_SERVICE_TOKEN in services/hub-api/.env (scope ai.read: GET /ai/read/* only).
# Set a long random value outside local dev.
AI_SERVICE_TOKEN=dev-only-ai-token-change-me
# LLM provider. Only "anthropic" is implemented. Without a key the service still starts and
# answers {"error": "ai_not_configured"}; the copilot panel then says "AI is not configured".
AI_PROVIDER=anthropic
AI_MODEL=claude-opus-5-5
# Your key; ANTHROPIC_API_KEY is read when AI_API_KEY is unset or empty. Never commit a key.
# AI_API_KEY=
# Thinking effort for copilot answers: low | medium | high | xhigh | max.
AI_EFFORT=medium
# Thinking effort for chat ordering's field extraction (S17, POST /chat/draft).
AI_CHAT_EFFORT=medium
