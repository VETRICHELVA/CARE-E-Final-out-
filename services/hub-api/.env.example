# Copy to .env. Values match infra/docker-compose.yml defaults.
# `dev` for local development. Unset (or anything else, e.g. `production`) counts as production:
# the hub then refuses to start while JWT_SECRET, INGEST_TOKEN or AI_SERVICE_TOKEN is a dev
# default or shorter than 32 characters, refuses a DATABASE_URL role that could rewrite the
# audit log, requires https webhooks, always refuses webhooks to internal addresses and ignores
# a LOGIN_RATE_LIMIT above 5. The Makefile sets APP_ENV=dev when it is unset.
APP_ENV=dev
# The hub and worker. In local dev this is the owner `care`; outside dev use the
# least-privilege role `care_app` (README, Configuration), e.g.
# postgresql+asyncpg://care_app:<password>@db:5432/care
DATABASE_URL=postgresql+asyncpg://care:care@127.0.0.1:5434/care
# Migrations and `make demo-reset` run as the tables' owner. Empty: DATABASE_URL.
MIGRATION_DATABASE_URL=
REDIS_URL=redis://127.0.0.1:6379/0
# Signs access tokens. Any long random string; must be set outside local dev.
JWT_SECRET=dev-only-change-me-dev-only-change-me
# Bearer token iot-ingest sends to POST /internal/telemetry (scope telemetry.write only).
# Must match INGEST_TOKEN in services/iot-ingest/.env; set a long random value outside local dev.
INGEST_TOKEN=dev-only-ingest-token-change-me
# OSRM road routing (S11, infra/osrm/README.md). Empty: haversine x 1.3 only. When set, a
# failing or slow (> 2 s) OSRM falls back to haversine.
OSRM_URL=
# Bearer token services/ai-service sends to GET /ai/read/* (scope ai.read only), with the
# signed-in user's access token in X-On-Behalf-Of. Must match AI_SERVICE_TOKEN in
# services/ai-service/.env; set a long random value outside local dev.
AI_SERVICE_TOKEN=dev-only-ai-token-change-me
# --- S20 hardening ---
# Browser origins allowed by CORS (comma-separated): the three apps.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175
# Login attempts per client IP per window (`make e2e` starts its hub with 100). Outside dev a
# value above 5, or a window under 60 s, is ignored.
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=60
# Reverse proxies whose X-Forwarded-For is trusted (IPs or CIDRs, comma-separated). Empty: none.
TRUSTED_PROXIES=
# Dev only: allow webhooks to a receiver on your machine or LAN.
WEBHOOK_ALLOW_PRIVATE_TARGETS=false
# Outbox retention for SSE replay and webhooks (the worker prunes hourly).
EVENT_RETENTION_HOURS=168
READING_EVENT_RETENTION_HOURS=24
