# Copy to .env. Values match infra/docker-compose.yml defaults.
# `dev` for local development. Unset or anything else counts as production: the ingest then
# refuses the dev INGEST_TOKEN below or one shorter than 32 characters. The Makefile sets
# APP_ENV=dev when it is unset.
APP_ENV=dev
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
HUB_API_URL=http://127.0.0.1:8000/api/v1
# Must equal INGEST_TOKEN in services/hub-api/.env; it grants scope telemetry.write only.
INGEST_TOKEN=dev-only-ingest-token-change-me
# Optional tuning (defaults shown).
# FLUSH_INTERVAL_S=2
# MAX_BATCH=500
# MAX_PENDING=10000
# DEDUP_WINDOW=50000
