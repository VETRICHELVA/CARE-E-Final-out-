# Copy to .env to override. The Makefile loads .env and exports it to docker compose.
# Host ports for infra/docker-compose.yml (bound to 127.0.0.1).
POSTGRES_PORT=5434
REDIS_PORT=6379
MQTT_PORT=1883
OSRM_PORT=5000

# Postgres credentials (dev only)
POSTGRES_USER=care
POSTGRES_PASSWORD=care
POSTGRES_DB=care
